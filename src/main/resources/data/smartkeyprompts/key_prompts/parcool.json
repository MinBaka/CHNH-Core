{
  "modid": "parcool",
  "vars": {
    "modLoaded": "true",
    "screenOpen": "isScreenOpen()",
    "isSprinting": "isSprinting()",
    "isCrouching": "isCrouching()",
    "onGround": "onGround()",
    "isFalling": "fallDistance() > 1.5"
  },
  "entries": [
    {
      "when": {
        "modLoaded": "true",
        "screenOpen": "false",
        "isSprinting": "true"
      },
      "then": [
        "show('parcool', 'key.parcool.Vault')",
        "show('parcool', 'key.parcool.FastRun')",
        "show('parcool', 'key.parcool.Dodge')",
        "show('parcool', 'key.parcool.Crawl')"
      ]
    },
    {
      "when": {
        "modLoaded": "true",
        "screenOpen": "false",
        "isFalling": "true"
      },
      "then": [
        "show('parcool', 'key.parcool.Breakfall')",
        "show('parcool', 'key.parcool.ClingToCliff')"
      ]
    },
    {
      "when": {
        "modLoaded": "true",
        "screenOpen": "false",
        "onGround": "false",
        "isFalling": "false"
      },
      "then": [
        "show('parcool', 'key.parcool.WallJump')",
        "show('parcool', 'key.parcool.HangDown')"
      ]
    },
    {
      "when": {
        "modLoaded": "true",
        "screenOpen": "false",
        "isCrouching": "true"
      },
      "then": [
        "show('parcool', 'key.parcool.Crawl')",
        "show('parcool', 'key.parcool.Flipping')"
      ]
    },
    {
      "when": {
        "modLoaded": "true",
        "screenOpen": "false",
        "isSprinting": "false",
        "isCrouching": "false",
        "onGround": "true"
      },
      "then": [
        "show('parcool', 'key.parcool.Vault')",
        "show('parcool', 'key.parcool.ClimbPoles')"
      ]
    }
  ]
}