{
  "modid": "parcool",
  "vars": {
    "modLoaded": "true",
    "screenOpen": "isScreenOpen()",
    "isCrouching": "isCrouching()",
    "isFallingFast": "fallDistance() > 3.0",
    "hasTaczGun": "mainHandItem() == 'tacz:modern_kinetic_gun'",
    "isSprinting": "isSprinting()"
  },
  "entries": [
    {
      "when": {
        "modLoaded": "true",
        "screenOpen": "false",
        "hasTaczGun": "true"
      },
      "then": [
        "show('parcool', 'key.parcool.Dodge')"
      ]
    },
    {
      "when": {
        "modLoaded": "true",
        "screenOpen": "false",
        "isCrouching": "false",
        "isFallingFast": "false",
        "hasTaczGun": "false",
        "isSprinting": "false"
      },
      "then": [
        "show('parcool', 'key.forward')",
        "show('parcool', 'key.parcool.Vault')",
        "show('parcool', 'key.parcool.FastRun')",
        "show('parcool', 'key.parcool.Dodge')",
        "show('parcool', 'key.parcool.WallJump')"
      ]
    },
    {
      "when": {
        "modLoaded": "true",
        "screenOpen": "false",
        "isCrouching": "false",
        "isFallingFast": "false",
        "hasTaczGun": "false",
        "isSprinting": "true"
      },
      "then": [
        "show('parcool', 'key.jump')",
        "show('parcool', 'key.parcool.Vault')",
        "show('parcool', 'key.parcool.FastRun')",
        "show('parcool', 'key.parcool.Dodge')",
        "show('parcool', 'key.parcool.WallJump')",
        "show('parcool', 'key.parcool.HorizontalWallRun')"
      ]
    },
    {
      "when": {
        "modLoaded": "true",
        "screenOpen": "false",
        "isCrouching": "true",
        "hasTaczGun": "false"
      },
      "then": [
        "show('parcool', 'key.parcool.Crawl')",
        "show('parcool', 'key.parcool.Flipping')",
        "show('parcool', 'key.parcool.HideInBlock')"
      ]
    },
    {
      "when": {
        "modLoaded": "true",
        "screenOpen": "false",
        "isFallingFast": "true",
        "hasTaczGun": "false"
      },
      "then": [
        "show('parcool', 'key.parcool.Breakfall')",
        "show('parcool', 'key.parcool.ClingToCliff')",
        "show('parcool', 'key.parcool.HangDown')"
      ]
    }
  ]
}